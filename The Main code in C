// LDR 5-LED Light Meter — Arduino R4 Minima
// Dark → 5 LEDs | Medium → 3 LEDs | Bright → 0 LEDs

const int LDR_PIN = A0;

// 5 LED pins (use any digital pins)
const int LED_PINS[5] = {2, 3, 4, 5, 6};

const int LOW_LIGHT_THRESHOLD  = 300;
const int HIGH_LIGHT_THRESHOLD = 700;

void setup() {
  for (int i = 0; i < 5; i++) {
    pinMode(LED_PINS[i], OUTPUT);
  }
  Serial.begin(9600);
  Serial.println("LDR 5-LED Meter — Starting...");
}

void setLEDs(int count) {
  for (int i = 0; i < 5; i++) {
    digitalWrite(LED_PINS[i], i < count ? HIGH : LOW);
  }
}

void loop() {
  int ldrValue = analogRead(LDR_PIN);

  Serial.print("LDR Value: ");
  Serial.print(ldrValue);

  if (ldrValue < LOW_LIGHT_THRESHOLD) {
    setLEDs(5);
    Serial.println("  → DARK → 5 LEDs ON");

  } else if (ldrValue < HIGH_LIGHT_THRESHOLD) {
    setLEDs(3);
    Serial.println("  → MEDIUM → 3 LEDs ON");

  } else {
    setLEDs(0);
    Serial.println("  → BRIGHT → all LEDs OFF");
  }

  delay(200);
}
