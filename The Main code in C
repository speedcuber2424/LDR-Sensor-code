
int ledPin = 5;                  // Selecting pin 5 for PWM output

// the setup function runs only once:
void setup() {

    Serial.begin(9600); // Initializing and setting the baud rate
    pinMode(ledPin, OUTPUT);   //pin 5 set to output mode
}

// the loop routine runs over and over again forever:
void loop() {

  // reads the input on analog pin A0 (value between 0 and 1023)
  int analogValue = analogRead(A0);     // Reading the LDR input 

  // map function to scale the analog value from 0 - 1023 to 0 - 255 for brightness control 
  int bright = map(analogValue, 0, 1023, 0, 255);
  bright = constrain(bright, 0, 255);

  analogWrite(ledPin, bright);       // sending brightness value to LED

 // print out the value
  Serial.print("Analog Value:  ");
  Serial.print(analogValue);
  Serial.print(",  Brightness:  ");
  Serial.println(bright);

  // checking the input LDR signal to decide on the level
  if (analogValue < 10) {
    Serial.println(" - It is Dark outside");
  } else if (analogValue < 200) {
    Serial.println(" - It is Dim light outside");
  } else if (analogValue < 500) {
    Serial.println(" - It is Normal light outside");
  } else if (analogValue < 800) {
    Serial.println(" - It is Bright outside");
  } else {
    Serial.println(" - It is Too Bright outside");
  }

 delay(200);

}
