// LDR + LED dimmer — Arduino UNO R4 Minima
// LDR voltage divider on A0, LED on D9 (PWM)

const int LDR_PIN = A0;
const int LED_PIN = 9;   // PWM pin

void setup() {
  pinMode(LED_PIN, OUTPUT);
  Serial.begin(9600);
}

void loop() {
  int ldrValue = analogRead(LDR_PIN);  // 0 (dark) to 1023 (bright)

  // Brighter room = dimmer LED (inverse map)
  int brightness = map(ldrValue, 0, 1023, 255, 0);

  analogWrite(LED_PIN, brightness);

  Serial.print("LDR: ");
  Serial.print(ldrValue);
  Serial.print("  |  LED brightness: ");
  Serial.println(brightness);

  delay(100);
}
