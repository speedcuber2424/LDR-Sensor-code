int ledPin = 5;

void setup() {
  Serial.begin(9600);
  pinMode(ledPin, OUTPUT);
}

void loop() {
  int analogValue = analogRead(A0);

  static int lastValue = -1;
  if (abs(analogValue - lastValue) > 5) {

    Serial.print("Light: ");
    Serial.print(analogValue);
    Serial.print(" | ");

    if (analogValue < 80) {
      analogWrite(ledPin, 255);
      Serial.println("DARK - LED full bright");
    } else if (analogValue < 200) {
      analogWrite(ledPin, 150);
      Serial.println("DIM - LED medium");
    } else if (analogValue < 320) {
      analogWrite(ledPin, 60);
      Serial.println("NORMAL - LED low");
    } else if (analogValue < 430) {
      analogWrite(ledPin, 0);
      Serial.println("BRIGHT - LED off");
    } else {
      analogWrite(ledPin, 0);
      Serial.println("TOO BRIGHT");
    }

    lastValue = analogValue;
  }

  delay(200);
}
